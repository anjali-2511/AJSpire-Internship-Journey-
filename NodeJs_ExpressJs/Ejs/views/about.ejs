<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
</head>

<body>
    <h1>
        <%= title %>
    </h1>

    <% if (message) { %>
        <p>
            <%= message %>
        </p>
        <% } else { %>
            <span>There is no message.</span>
            <% } %>




                <ul>
                    <% items.forEach(item=> { %>
                        <li>
                            <%= item _%>
                        </li>
                        <% }) %>
                </ul>

                <table border="'1" width="500px">
                    <% objects.forEach(object=> { %>
                        <tr>
                            <td>
                                <%= object.name _%>
                            </td>
                            <td>
                                <%= object.color _%>
                            </td>
                            <td>
                                <%= object.bg _%>
                            </td>
                        </tr>
                        <% }) %>
                </table>
</body>

</html>