<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Area of Rectangle Calculator</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

    <div class="container mt-5">

        <div class="row justify-content-center">

            <div class="col-md-5">

                <div class="card shadow-lg p-4">

                    <h2 class="text-center text-primary mb-4">
                        Area of Triangle 
                    </h2>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Enter Base
                        </label>
                        <input type="number" class="form-control" id="base" placeholder="Enter Base">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Enter Height
                        </label>
                        <input type="number" class="form-control" id="height" placeholder="Enter height">
                    </div>

                    <div class="d-grid mb-3">
                        <button class="btn btn-primary" onclick="triangle()">
                            Calculate Area
                        </button>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Area of Triangle
                        </label>
                        <input type="text" class="form-control" id="Ans" readonly>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <script>
        function triangle() {

            var base = parseFloat(document.getElementById("base").value) || 0;
            var height = parseFloat(document.getElementById("height").value) || 0;

            var area = 0.5 * base * height;

            document.getElementById("Ans").value = area.toFixed(2);    //.toFixed(2) means it will show 2 decimal no.

        }
    </script>

</body>

</html>